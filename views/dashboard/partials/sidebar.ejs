<aside class="sidebar">
  <div class="sidebar__brand">
    <img src="/alphahill_logo_white_transparent.png" alt="Alpha Hill Medical Centre" />
    <span>Dashboard</span>
  </div>

  <nav aria-label="Dashboard">
    <div class="nav-group">
      <ul>
        <li>
          <a href="/dashboard" class="<%= active === 'overview' ? 'is-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z" />
            </svg>
            Overview
          </a>
        </li>
        <li>
          <a href="/dashboard/news" class="<%= active === 'news' ? 'is-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 3h13a2 2 0 0 1 2 2v14a2 2 0 0 0 2-2V7h2v12a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V5a2 2 0 0 1 2-2Zm2 4v2h9V7H6Zm0 4v2h9v-2H6Zm0 4v2h6v-2H6Z" />
            </svg>
            News &amp; Events
          </a>
        </li>
        <li>
          <a href="/dashboard/reviews" class="<%= active === 'reviews' ? 'is-active' : '' %>">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z" />
            </svg>
            Reviews
            <% if (counts && counts.reviews > 0) { %>
              <span class="nav-badge" aria-label="<%= counts.reviews %> awaiting approval"><%= counts.reviews %></span>
            <% } %>
          </a>
        </li>
      </ul>
    </div>

    <div class="nav-group">
      <p class="nav-group__label">Submissions</p>
      <ul>
        <% Object.entries(submissionTypes).forEach(function (entry) { %>
          <% const slug = entry[0]; const type = entry[1]; %>
          <li>
            <a
              href="/dashboard/submissions/<%= slug %>"
              class="<%= active === 'submissions:' + slug ? 'is-active' : '' %>"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm8 7 8-5H4Z" />
              </svg>
              <%= type.label %>
              <% if (counts && counts[slug] > 0) { %>
                <span class="nav-badge" aria-label="<%= counts[slug] %> unread"><%= counts[slug] %></span>
              <% } %>
            </a>
          </li>
        <% }); %>
      </ul>
    </div>
  </nav>

  <div class="sidebar__foot">
    <p class="who">Signed in as <%= user ? user.name : '' %></p>
    <a class="site-link" href="/" target="_blank" rel="noopener noreferrer">View public site →</a>
    <form method="post" action="/dashboard/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="linkbtn">Sign out</button>
    </form>
  </div>
</aside>
