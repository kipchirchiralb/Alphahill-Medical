<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <!-- Private staff area: never index, never follow, never preview. -->
    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
    />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />

    <!-- Styles and icon are served locally; no fonts, analytics or CDNs are
         loaded anywhere in the dashboard. -->
    <link rel="stylesheet" href="/assets/css/dashboard.css" />
    <link rel="icon" type="image/png" href="/alphahillmedicallogo.png" />
  </head>
