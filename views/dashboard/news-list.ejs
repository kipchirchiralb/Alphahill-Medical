<%- include('partials/head') %>
<body>
  <div class="shell">
    <%- include('partials/sidebar') %>

    <main class="main">
      <div class="page-head">
        <div>
          <h1>News &amp; Events</h1>
          <p>
            Publish medical camps, blood drives, vaccination campaigns,
            announcements and outreach activities to the public News page.
          </p>
        </div>
        <div class="head-actions">
          <a class="btn btn--outline" href="/news" target="_blank" rel="noopener noreferrer">
            View public page
          </a>
          <a class="btn btn--primary" href="/dashboard/news/new">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z" />
            </svg>
            New post
          </a>
        </div>
      </div>

      <%- include('partials/flash') %>

      <% const newsQuery = { status: filter, q: q, category: category }; %>
      <div class="toolbar">
        <div class="filters">
          <a href="<%= listHref('/dashboard/news', newsQuery, { status: 'all', page: 1 }) %>" class="<%= filter === 'all' ? 'is-active' : '' %>">All</a>
          <a href="<%= listHref('/dashboard/news', newsQuery, { status: 'published', page: 1 }) %>" class="<%= filter === 'published' ? 'is-active' : '' %>">Published</a>
          <a href="<%= listHref('/dashboard/news', newsQuery, { status: 'draft', page: 1 }) %>" class="<%= filter === 'draft' ? 'is-active' : '' %>">Drafts</a>
        </div>

        <form class="search-form" method="get" action="/dashboard/news" role="search">
          <% if (filter !== 'all') { %>
            <input type="hidden" name="status" value="<%= filter %>" />
          <% } %>
          <label class="visually-hidden" for="news-category">Category</label>
          <select id="news-category" name="category">
            <option value="">All categories</option>
            <% categories.forEach(function (name) { %>
              <option value="<%= name %>" <%= category === name ? 'selected' : '' %>><%= name %></option>
            <% }); %>
          </select>
          <label class="visually-hidden" for="news-q">Search posts</label>
          <input
            type="search"
            id="news-q"
            name="q"
            value="<%= q %>"
            maxlength="80"
            placeholder="Search title, category or body"
          />
          <button class="btn btn--outline" type="submit">Search</button>
          <% if (q || category) { %>
            <a class="btn btn--outline" href="<%= listHref('/dashboard/news', { status: filter }) %>">Clear</a>
          <% } %>
        </form>
      </div>

      <section class="card">
        <% if (posts.length === 0) { %>
          <div class="empty">
            <% if (q || category) { %>
              <h3>No matching posts</h3>
              <p>
                Nothing matched
                <% if (q) { %>“<%= q %>”<% } %>
                <% if (category) { %><%= q ? ' in ' : '' %><%= category %><% } %>.
                Try a different search or
                <a href="<%= listHref('/dashboard/news', { status: filter }) %>">clear filters</a>.
              </p>
            <% } else if (filter === 'published') { %>
              <h3>No published posts</h3>
              <p>Drafts stay private until you publish them.</p>
            <% } else if (filter === 'draft') { %>
              <h3>No drafts</h3>
              <p>Everything is published, or you have not started a post yet.</p>
            <% } else { %>
              <h3>No posts yet</h3>
              <p>
                Anything you publish appears on the public News &amp; Events page
                straight away. Drafts stay private until you publish them.
              </p>
              <p style="margin-top: 1rem">
                <a class="btn btn--primary btn--sm" href="/dashboard/news/new">Create the first post</a>
              </p>
            <% } %>
          </div>
        <% } else { %>
          <% if (q || category || pager.needed) { %>
            <p class="result-meta">
              Showing <%= pager.from %>–<%= pager.to %> of <%= pager.total %>
              <%= pager.total === 1 ? 'post' : 'posts' %>
              <% if (q) { %> matching “<%= q %>”<% } %>
            </p>
          <% } %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Category</th>
                  <th class="nowrap">Event date</th>
                  <th>Status</th>
                  <th class="nowrap">Published</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% posts.forEach(function (post) { %>
                  <tr>
                    <td>
                      <a class="primary-text" href="/dashboard/news/<%= post.id %>/edit"><%= post.title %></a>
                      <% if (post.excerpt) { %>
                        <span class="longtext" style="font-size:.82rem"><%= post.excerpt %></span>
                      <% } %>
                    </td>
                    <td><span class="badge badge--cat"><%= post.category %></span></td>
                    <td class="nowrap muted"><%= post.event_date ? formatDate(post.event_date) : '—' %></td>
                    <td><span class="badge badge--<%= post.status %>"><%= post.status %></span></td>
                    <td class="nowrap muted"><%= post.published_at ? formatDateTime(post.published_at) : '—' %></td>
                    <td>
                      <div class="row-actions">
                        <a class="btn btn--outline btn--sm" href="/dashboard/news/<%= post.id %>/edit">Edit</a>

                        <% if (post.status === 'published') { %>
                          <a class="btn btn--outline btn--sm" href="/news/<%= post.slug %>" target="_blank" rel="noopener noreferrer">View</a>
                          <form class="inline-form" method="post" action="/dashboard/news/<%= post.id %>/status">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="hidden" name="status" value="draft" />
                            <button class="btn btn--outline btn--sm" type="submit">Unpublish</button>
                          </form>
                        <% } else { %>
                          <form class="inline-form" method="post" action="/dashboard/news/<%= post.id %>/status">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="hidden" name="status" value="published" />
                            <button class="btn btn--primary btn--sm" type="submit">Publish</button>
                          </form>
                        <% } %>

                        <form
                          class="inline-form"
                          method="post"
                          action="/dashboard/news/<%= post.id %>/delete"
                          data-confirm="Delete “<%= post.title %>”? This cannot be undone."
                        >
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button class="btn btn--danger btn--sm" type="submit">Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <%- include('partials/pager', { pager: pager, hrefBase: '/dashboard/news', query: newsQuery }) %>
        <% } %>
      </section>
    </main>
  </div>
  <script src="/assets/js/dashboard.js"></script>
</body>
</html>
