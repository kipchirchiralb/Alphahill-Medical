<%- include('partials/head') %>
<body>
  <div class="shell">
    <%- include('partials/sidebar') %>

    <main class="main">
      <div class="page-head">
        <div>
          <h1><%= type.label %></h1>
          <p><%= type.description %></p>
        </div>
        <div class="head-actions">
          <a class="btn btn--outline" href="/dashboard/submissions/<%= typeSlug %>/export.csv">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 3v10.6l3.3-3.3 1.4 1.4-5.7 5.7-5.7-5.7 1.4-1.4L10 13.6V3h2ZM4 19h16v2H4v-2Z" />
            </svg>
            Export CSV
          </a>
        </div>
      </div>

      <%- include('partials/flash') %>

      <% const listQuery = { status: filter, q: q }; %>
      <% const listPath = '/dashboard/submissions/' + typeSlug; %>
      <div class="toolbar">
        <div class="filters">
          <a href="<%= listHref(listPath, listQuery, { status: 'all', page: 1 }) %>" class="<%= filter === 'all' ? 'is-active' : '' %>">
            All <span class="count">(<%= tally.total || 0 %>)</span>
          </a>
          <a href="<%= listHref(listPath, listQuery, { status: 'new', page: 1 }) %>" class="<%= filter === 'new' ? 'is-active' : '' %>">
            New <span class="count">(<%= tally.new_count || 0 %>)</span>
          </a>
          <a href="<%= listHref(listPath, listQuery, { status: 'read', page: 1 }) %>" class="<%= filter === 'read' ? 'is-active' : '' %>">
            Read <span class="count">(<%= tally.read_count || 0 %>)</span>
          </a>
          <a href="<%= listHref(listPath, listQuery, { status: 'handled', page: 1 }) %>" class="<%= filter === 'handled' ? 'is-active' : '' %>">
            Handled <span class="count">(<%= tally.handled_count || 0 %>)</span>
          </a>
        </div>

        <form class="search-form" method="get" action="<%= listPath %>" role="search">
          <% if (filter !== 'all') { %>
            <input type="hidden" name="status" value="<%= filter %>" />
          <% } %>
          <label class="visually-hidden" for="submissions-q">Search <%= type.label.toLowerCase() %></label>
          <input
            type="search"
            id="submissions-q"
            name="q"
            value="<%= q %>"
            maxlength="80"
            placeholder="Search <%= type.label.toLowerCase() %>"
          />
          <button class="btn btn--outline" type="submit">Search</button>
          <% if (q) { %>
            <a class="btn btn--outline" href="<%= listHref(listPath, { status: filter }) %>">Clear</a>
          <% } %>
        </form>
      </div>

      <section class="card">
        <% if (rows.length === 0) { %>
          <div class="empty">
            <% if (q) { %>
              <h3>No matching <%= type.label.toLowerCase() %></h3>
              <p>
                Nothing matched “<%= q %>”.
                <a href="<%= listHref(listPath, { status: filter }) %>">Clear the search</a>
                <% if (filter !== 'all') { %> or try All.<% } %>
              </p>
            <% } else if (filter === 'all') { %>
              <h3>No <%= type.singular %> records yet</h3>
              <p>
                As soon as someone submits the form on the website, it will
                appear here.
              </p>
            <% } else { %>
              <h3>No <%= type.singular %> records with this status</h3>
              <p>
                Try a different filter to see the rest of the <%= type.label.toLowerCase() %>.
              </p>
            <% } %>
          </div>
        <% } else { %>
          <% if (q || pager.needed) { %>
            <p class="result-meta">
              Showing <%= pager.from %>–<%= pager.to %> of <%= pager.total %>
              <% if (q) { %> matching “<%= q %>”<% } %>
            </p>
          <% } %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th class="nowrap">Received</th>
                  <% type.columns.forEach(function (column) { %>
                    <th><%= column.label %></th>
                  <% }); %>
                  <th>Status</th>
                  <th>Mark as</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (row) { %>
                  <tr class="<%= row.status === 'new' ? 'is-unread' : '' %>">
                    <td class="nowrap muted"><%= formatDateTime(row.created_at) %></td>

                    <% type.columns.forEach(function (column, index) { %>
                      <td>
                        <% const value = row[column.key]; %>
                        <% if (!value) { %>
                          <span class="muted">—</span>
                        <% } else if (column.wide) { %>
                          <span class="longtext"><%= value %></span>
                        <% } else if (column.type === 'date') { %>
                          <span class="nowrap"><%= formatDate(value) %></span>
                        <% } else if (column.key === 'email') { %>
                          <a href="mailto:<%= value %>"><%= value %></a>
                        <% } else if (column.key === 'phone') { %>
                          <a class="nowrap" href="tel:<%= String(value).replace(/\s+/g, '') %>"><%= value %></a>
                        <% } else if (index === 0) { %>
                          <span class="primary-text"><%= value %></span>
                        <% } else { %>
                          <%= value %>
                        <% } %>
                      </td>
                    <% }); %>

                    <td><span class="badge badge--<%= row.status %>"><%= row.status %></span></td>

                    <td>
                      <div class="row-actions">
                        <% statuses.filter(function (s) { return s !== row.status; }).forEach(function (status) { %>
                          <form class="inline-form" method="post" action="/dashboard/submissions/<%= typeSlug %>/<%= row.id %>/status">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="hidden" name="status" value="<%= status %>" />
                            <input
                              type="hidden"
                              name="redirect_to"
                              value="<%= listHref(listPath, listQuery, { page: pager.page }) %>"
                            />
                            <button class="btn btn--outline btn--sm" type="submit"><%= status %></button>
                          </form>
                        <% }); %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <%- include('partials/pager', { pager: pager, hrefBase: listPath, query: listQuery }) %>
        <% } %>
      </section>
    </main>
  </div>
  <script src="/assets/js/dashboard.js"></script>
</body>
</html>
