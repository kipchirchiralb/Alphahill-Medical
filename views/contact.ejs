  <body>
    <%- include('partials/public-header', { current: 'contact' }) %>

    <main id="main">
      <section class="page-hero" aria-labelledby="page-title">
        <div class="page-hero__bg">
          <img
            src="images/office front with logo.jpeg"
            alt="The front entrance of Alpha Hill Medical Centre"
          />
        </div>
        <div class="container">
          <p class="breadcrumb"><a href="/">Home</a><span>/</span>Contact Us</p>
          <h1 id="page-title">Get in Touch</h1>
          <p>We are here for you 24 hours a day, 7 days a week.</p>
        </div>
      </section>

      <section class="section" aria-labelledby="contact-title">
        <div class="container">
          <h2
            id="contact-title"
            class="visually-hidden"
            style="position: absolute; left: -9999px"
          >
            Contact details and enquiry form
          </h2>
          <div class="contact-grid">
            <!-- Contact info -->
            <div class="reveal">
              <p class="eyebrow">Reach Us</p>
              <h2 style="font-size: clamp(1.6rem, 3.5vw, 2.2rem)">
                Contact Details
              </h2>
              <address style="font-style: normal">
                <ul class="info-list">
                  <li>
                    <span class="ic" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.24 1Z"
                        />
                      </svg>
                    </span>
                    <div>
                      <h3>Phone</h3>
                      <a href="tel:+254722865459">+254 722 865 459</a><br /><a
                        href="tel:+254722419080"
                        >+254 722 419 080</a
                      >
                    </div>
                  </li>
                  <li>
                    <span class="ic" aria-hidden="true"
                      ><svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm8 7 8-5H4Z"
                        />
                      </svg>
                    </span>
                    <div>
                      <h3>Email</h3>
                      <a href="mailto:alphahillmedical@gmail.com"
                        >alphahillmedical@gmail.com</a
                      >
                    </div>
                  </li>
                  <li>
                    <span class="ic" aria-hidden="true"
                      ><svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
                      </svg>
                    </span>
                    <div>
                      <h3>Website</h3>
                      <a href="https://alphahillmedical.co.ke"
                        >alphahillmedical.co.ke</a
                      >
                    </div>
                  </li>
                  <li>
                    <span class="ic" aria-hidden="true"
                      ><svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5Z"
                        />
                      </svg>
                    </span>
                    <div>
                      <h3>Physical Address</h3>
                      <p>
                        Along Mosoriot – Kabiyet Road,<br />Mosoriot, Nandi
                        County, Kenya
                      </p>
                    </div>
                  </li>
                  <li>
                    <span class="ic" aria-hidden="true"
                      ><svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M20 4H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 5H4V6h16Z"
                        />
                      </svg>
                    </span>
                    <div>
                      <h3>Postal Address</h3>
                      <p>P.O. Box 8620 – 30100, Mosoriot</p>
                    </div>
                  </li>
                  <li>
                    <span class="ic" aria-hidden="true"
                      ><svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm1 10.41 4.29 4.3-1.42 1.41L11 13.24V6h2Z"
                        />
                      </svg>
                    </span>
                    <div>
                      <h3>Opening Hours</h3>
                      <p>Open 24 hours, 7 days a week</p>
                    </div>
                  </li>
                </ul>
              </address>
            </div>

            <!-- Enquiry form -->
            <div class="reveal">
              <p class="eyebrow">Send a Message</p>
              <h2 style="font-size: clamp(1.6rem, 3.5vw, 2.2rem)">
                Enquiry Form
              </h2>
              <form id="enquiry-form" class="form" novalidate>
                <div class="row">
                  <div class="field">
                    <label for="name"
                      >Full Name
                      <span class="req" aria-hidden="true">*</span></label
                    >
                    <input
                      type="text"
                      id="name"
                      name="full_name"
                      autocomplete="name"
                      required
                    />
                  </div>
                  <div class="field">
                    <label for="phone"
                      >Phone Number
                      <span class="req" aria-hidden="true">*</span></label
                    >
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      autocomplete="tel"
                      required
                    />
                  </div>
                </div>
                <div class="field">
                  <label for="email"
                    >Email
                    <span style="font-weight: 400; color: var(--muted)"
                      >(optional)</span
                    ></label
                  >
                  <input
                    type="email"
                    id="email"
                    name="email"
                    autocomplete="email"
                  />
                </div>
                <div class="field">
                  <label for="service">Service of Interest</label>
                  <select id="service" name="service">
                    <option value="">Select a service…</option>
                    <option>Intensive Care (ICU)</option>
                    <option>Maternity Services</option>
                    <option>Major &amp; Minor Surgeries</option>
                    <option>CT Scan Services</option>
                    <option>X-Ray Services</option>
                    <option>Ultrasound Services</option>
                    <option>Endoscopy &amp; Colonoscopy</option>
                    <option>Dental Services</option>
                    <option>Eyecare / Optometry</option>
                    <option>Dialysis Services</option>
                    <option>Physiotherapy</option>
                    <option>24-Hour Laboratory</option>
                    <option>24-Hour Pharmacy</option>
                    <option>Inpatient &amp; Outpatient Care</option>
                    <option>General Enquiry</option>
                  </select>
                </div>
                <div class="field">
                  <label for="message"
                    >Message
                    <span class="req" aria-hidden="true">*</span></label
                  >
                  <textarea id="message" name="message" required></textarea>
                </div>
                <button class="btn btn--primary" type="submit">
                  Send Enquiry
                </button>
                <p
                  id="form-status"
                  class="form-status"
                  role="status"
                  aria-live="polite"
                ></p>
                <p class="form-note">
                  For medical emergencies, please call
                  <a href="tel:+254722865459">+254 722 865 459</a> directly.
                </p>
              </form>
            </div>
          </div>
        </div>
      </section>

      <!-- Map -->
      <section class="section section--grey" aria-labelledby="map-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Find Us</p>
            <h2 id="map-title">Location &amp; Map</h2>
            <p>Along Mosoriot – Kabiyet Road, Mosoriot, Nandi County.</p>
            <div class="rule"></div>
          </div>
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7815.386203989644!2d35.16001436104049!3d0.3211582095467911!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x178059104b9ab091%3A0xc1e0a95afb12ec5!2sAlpha%20Hill%20Medical%20Centre!5e0!3m2!1sen!2ske!4v1782986005891!5m2!1sen!2ske"
            width="100%"
            height="450"
            style="border: 0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </section>
    </main>

    <%- include('partials/public-footer') %>

    <script src="/assets/js/main.js"></script>
  </body>
</html>
