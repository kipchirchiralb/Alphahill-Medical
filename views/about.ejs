            "alternateName": "Alpha Hill Hospital",
            "slogan": "Inspiring Better Healthcare",
            "url": "https://alphahillmedical.co.ke/",
            "logo": "https://alphahillmedical.co.ke/alphahillmedicallogo.png",
            "image": "https://alphahillmedical.co.ke/images/alphahillallstaff.jpeg",
            "description": "Alpha Hill Medical Centre is a pioneering, accredited hospital in Mosoriot, Nandi County, Kenya, delivering comprehensive, integrated and affordable healthcare with kindness and integrity.",
            "email": "alphahillmedical@gmail.com",
            "telephone": "+254722865459",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Along Mosoriot – Kabiyet Road",
              "addressLocality": "Mosoriot",
              "addressRegion": "Nandi County",
              "postalCode": "30100",
              "addressCountry": "KE"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 0.3211582,
              "longitude": 35.1600144
            },
            "openingHours": "Mo-Su 00:00-23:59",
            "areaServed": [
              { "@type": "AdministrativeArea", "name": "Nandi County" },
              { "@type": "Country", "name": "Kenya" }
            ],
            "hasCredential": [
              {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": "Accreditation",
                "name": "SHA — Social Health Authority"
              },
              {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": "Accreditation",
                "name": "KMPDC — Kenya Medical Practitioners and Dentists Council"
              },
              {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": "Accreditation",
                "name": "NCK — Nursing Council of Kenya"
              },
              {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": "Accreditation",
                "name": "PPB — Pharmacy and Poisons Board"
              }
            ]
          },
          {
            "@type": "AboutPage",
            "@id": "https://alphahillmedical.co.ke/about#webpage",
            "url": "https://alphahillmedical.co.ke/about",
            "name": "About Us | Alpha Hill Medical Centre",
            "description": "Learn about Alpha Hill Medical Centre — our mission, vision, core values and accreditations (SHA, KMPDC, NCK, PPB). Pioneering affordable, compassionate healthcare in Nandi County, Kenya.",
            "about": { "@id": "https://alphahillmedical.co.ke/#organization" },
            "mainEntity": {
              "@id": "https://alphahillmedical.co.ke/#organization"
            },
            "inLanguage": "en"
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://alphahillmedical.co.ke/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "About Us",
                "item": "https://alphahillmedical.co.ke/about"
              }
            ]
          }
        ]
      }
    </script>
  </head>
  <body>
    <%- include('partials/public-header', { current: 'about' }) %>

    <main id="main">
      <!-- Page banner -->
      <section class="page-hero" aria-labelledby="page-title">
        <div class="page-hero__bg">
          <img
            src="images/alphahillallstaff.jpeg"
            alt="The Alpha Hill Medical Centre team"
          />
        </div>
        <div class="container">
          <p class="breadcrumb"><a href="/">Home</a><span>/</span>About Us</p>
          <h1 id="page-title">About Alpha Hill Medical Centre</h1>
          <p>
            Pioneering comprehensive, integrated and affordable healthcare for
            every family in Nandi County.
          </p>
        </div>
      </section>

      <!-- Intro -->
      <section class="section" aria-labelledby="intro-title">
        <div class="container split">
          <div class="reveal">
            <p class="eyebrow">Who We Are</p>
            <h2 id="intro-title">
              A pioneering healthcare facility in Mosoriot
            </h2>
            <p class="lead">
              Alpha Hill Medical Centre exists to make comprehensive, integrated
              and affordable healthcare available to every family in our region
              — without compromising on quality or compassion.
            </p>
            <p>
              We always take care to ensure we comply with KMPDC and Ministry of
              Health standards. This also means consistent compliance with our
              medical ethics, which is the basis of all we do. We are pioneers
              and role models in care standards.
            </p>
            <a class="arrow-link" href="/services">Explore our services →</a>
          </div>
          <div class="split__media reveal">
            <img
              src="images/office front with logo.jpeg"
              alt="The entrance of Alpha Hill Medical Centre with signage"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Mission / Vision -->
      <section class="section section--grey" aria-labelledby="mv-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Our Purpose</p>
            <h2 id="mv-title">Mission &amp; Vision</h2>
            <div class="rule"></div>
          </div>
          <div class="grid grid--2">
            <article class="card reveal">
              <h3>Our Mission</h3>
              <p>
                To preserve life and enhance health by enabling access to
                comprehensive, integrated, high-quality and most affordable care
                — delivered with kindness, integrity and respect.
              </p>
            </article>
            <article class="card reveal">
              <h3>Our Vision</h3>
              <p>
                Alpha Hill Medical Centre will continue to provide a continuum
                of high-quality, cost-effective services in order to improve the
                health status of the community we serve.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Core values -->
      <section class="section" aria-labelledby="values-title">
        <div class="container split">
          <div class="split__media reveal">
            <img
              src="images/staff team building.jpeg"
              alt="Alpha Hill staff during a team-building activity"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="reveal">
            <p class="eyebrow">What Guides Us</p>
            <h2 id="values-title">Our Core Values</h2>
            <p>We treat those we serve and one another with:</p>
            <ul class="check-list">
              <li>
                <span
                  ><strong>Professionalism</strong> — excellence and
                  accountability in everything we do.</span
                >
              </li>
              <li>
                <span
                  ><strong>Kindness</strong> — compassionate care for every
                  patient.</span
                >
              </li>
              <li>
                <span
                  ><strong>Respect</strong> — for patients, families and
                  colleagues.</span
                >
              </li>
              <li>
                <span
                  ><strong>Honesty</strong> — transparent communication at all
                  times.</span
                >
              </li>
              <li>
                <span
                  ><strong>Integrity</strong> — ethical practice as the
                  foundation of our work.</span
                >
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section
        class="section section--navy"
        aria-label="Alpha Hill at a glance"
      >
        <div class="container stats">
          <div>
            <div class="num">24/7</div>
            <div class="lbl">Emergency Care</div>
          </div>
          <div>
            <div class="num">14+</div>
            <div class="lbl">Medical Services</div>
          </div>
          <div>
            <div class="num">4</div>
            <div class="lbl">National Accreditations</div>
          </div>
          <div>
            <div class="num">1</div>
            <div class="lbl">Roof, Full Continuum of Care</div>
          </div>
        </div>
      </section>

      <!-- Accreditations -->
      <section class="section section--grey" aria-labelledby="accred-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Trust &amp; Compliance</p>
            <h2 id="accred-title">Our Accreditations</h2>
            <p>
              We are licensed and accredited by Kenya's leading healthcare
              regulators.
            </p>
            <div class="rule"></div>
          </div>
          <div class="grid grid--4">
            <article class="card reveal">
              <h3>SHA</h3>
              <p>Social Health Authority.</p>
            </article>
            <article class="card reveal">
              <h3>KMPDC</h3>
              <p>Kenya Medical Practitioners and Dentists Council.</p>
            </article>
            <article class="card reveal">
              <h3>NCK</h3>
              <p>Nursing Council of Kenya.</p>
            </article>
            <article class="card reveal">
              <h3>PPB</h3>
              <p>Pharmacy and Poisons Board.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- ==================== TRAINING FOR BETTER CARE ============= -->
      <section
        class="section training-highlight"
        aria-labelledby="training-title"
      >
        <div class="container">
          <div class="training-highlight__panel reveal">
            <div class="training-highlight__content">
              <p class="eyebrow">Training for Better Care</p>
              <h2 id="training-title">
                A stronger clinical workforce, supporting better patient
                outcomes
              </h2>
              <p class="lead">
                Alpha Hill Medical Centre is directly linked to Alpha Hill
                Training Institute, a relationship that strengthens the
                availability of well-trained professionals and supports
                high-quality care for every patient.
              </p>
              <p>
                Through this connection, our teams benefit from continuous
                professional development, practical exposure and a shared
                commitment to compassionate, evidence-based healthcare delivered
                with integrity.
              </p>
              <a
                class="btn btn--primary"
                href="https://alphahill.ac.ke"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit Alpha Hill Training Institute
              </a>
            </div>
            <div class="training-highlight__media">
              <img
                src="images/miainentrancegatealpahahillinstitute.jpeg"
                alt="Main entrance gate of Alpha Hill Training Institute"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section
        class="section section--navy quote-banner"
        aria-label="Core commitment"
      >
        <div class="container">
          <p class="mark" aria-hidden="true">“</p>
          <blockquote>
            We treat those we serve and one another with Professionalism,
            Kindness, Respect, Honesty and Integrity.
          </blockquote>
          <cite>Our Core Commitment</cite>
        </div>
      </section>
    </main>

    <%- include('partials/public-footer') %>

    <script src="/assets/js/main.js"></script>
  </body>
</html>
