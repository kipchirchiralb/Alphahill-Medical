<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-text"
>
  <div class="cookie-banner__inner">
    <div>
      <h2 id="cookie-banner-title">Cookies on this website</h2>
      <p id="cookie-banner-text">
        We use a small first-party cookie to count visits after you opt in.
        We do not use Google Analytics or other advertising trackers.
        Read our
        <a href="/cookies">Cookies Policy</a>
        and
        <a href="/privacy">Privacy Policy</a>.
      </p>
    </div>
    <form
      id="cookie-consent-form"
      class="cookie-banner__actions"
      method="post"
      action="/api/consent"
    >
      <input type="hidden" name="path" id="cookie-path" value="/" />
      <button
        class="btn btn--ghost-light"
        type="submit"
        name="choice"
        value="declined"
      >
        Decline
      </button>
      <button
        class="btn btn--primary"
        type="submit"
        name="choice"
        value="accepted"
      >
        Accept
      </button>
    </form>
  </div>
</div>
<script>
  (function () {
    var banner = document.getElementById("cookie-banner");
    var pathField = document.getElementById("cookie-path");
    if (pathField) pathField.value = window.location.pathname || "/";
    if (!banner) return;
    var cookies = document.cookie ? document.cookie.split(";") : [];
    for (var i = 0; i < cookies.length; i++) {
      if (cookies[i].trim().indexOf("ahmc_consent=") === 0) {
        banner.hidden = true;
        return;
      }
    }
  })();
</script>
