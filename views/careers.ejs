<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Careers | Alpha Hill Medical Centre — Mosoriot, Nandi County</title>
    <meta
      name="description"
      content="Join Alpha Hill Medical Centre. Explore vacancies, internships, student attachments and volunteer opportunities in Mosoriot, Nandi County, and apply online."
    />
    <link rel="canonical" href="<%= site %>/careers" />
    <meta name="theme-color" content="#001F5D" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alpha Hill Medical Centre" />
    <meta property="og:title" content="Careers at Alpha Hill Medical Centre" />
    <meta
      property="og:description"
      content="Vacancies, internships, attachments and volunteer opportunities at a modern 24-hour hospital in Nandi County."
    />
    <meta property="og:url" content="<%= site %>/careers" />
    <meta
      property="og:image"
      content="<%= site %>/images/alphahillallstaff.jpeg"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="icon" type="image/png" href="/alphahillmedicallogo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/styles.css" />
  </head>
  <body>
    <%- include('partials/public-header', { current: 'careers' }) %>

    <main id="main">
      <section class="page-hero" aria-labelledby="page-title">
        <div class="page-hero__bg">
          <img
            src="/images/alphahillallstaff.jpeg"
            alt="The team at Alpha Hill Medical Centre"
          />
        </div>
        <div class="container">
          <p class="breadcrumb"><a href="/">Home</a><span>/</span>Careers</p>
          <h1 id="page-title">Build Your Career With Us</h1>
          <p>
            Join a team that is raising the standard of healthcare in Nandi
            County.
          </p>
        </div>
      </section>

      <!-- ==================== WHY JOIN ==================== -->
      <section class="section" aria-labelledby="why-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Why Alpha Hill</p>
            <h2 id="why-title">A place to grow and to serve</h2>
            <p>
              We are a modern 24-hour hospital with ICU, maternity, theatre,
              imaging and dialysis services — and a culture built on kindness,
              integrity and respect.
            </p>
            <div class="rule"></div>
          </div>

          <div class="grid grid--3">
            <article class="card reveal">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-4Zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6Z" />
                </svg>
              </span>
              <h3>Meaningful work</h3>
              <p>
                Care for patients across Nandi County in a facility accredited
                by SHA, KMPDC, NCK and PPB.
              </p>
            </article>

            <article class="card reveal">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3ZM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82Z" />
                </svg>
              </span>
              <h3>Continuous learning</h3>
              <p>
                Regular continuing medical education, upskilling sessions and
                mentorship from experienced clinicians.
              </p>
            </article>

            <article class="card reveal">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 11c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3Zm-8 0c1.66 0 3-1.34 3-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z" />
                </svg>
              </span>
              <h3>A supportive team</h3>
              <p>
                Work alongside colleagues who look out for one another, with
                team-building and staff wellbeing built into the year.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ==================== OPPORTUNITIES ==================== -->
      <section class="section section--grey" aria-labelledby="opps-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Ways to Join</p>
            <h2 id="opps-title">Opportunities available</h2>
            <p>
              We accept applications throughout the year. Tell us which route
              suits you and our human resource team will be in touch.
            </p>
            <div class="rule"></div>
          </div>

          <div class="grid grid--4">
            <article class="card reveal">
              <h3>Vacancies</h3>
              <p>
                Clinical and non-clinical roles across nursing, laboratory,
                pharmacy, imaging, administration and support services.
              </p>
              <a class="card__link" href="#apply">Apply now</a>
            </article>

            <article class="card reveal">
              <h3>Internships</h3>
              <p>
                Structured internship placements for recent graduates seeking
                supervised, hands-on hospital experience.
              </p>
              <a class="card__link" href="#apply">Apply now</a>
            </article>

            <article class="card reveal">
              <h3>Attachments</h3>
              <p>
                Student attachment slots for colleges and universities, with
                mentorship in your area of study.
              </p>
              <a class="card__link" href="#apply">Apply now</a>
            </article>

            <article class="card reveal">
              <h3>Volunteering</h3>
              <p>
                Support our medical camps, outreach programmes and community
                health campaigns as a volunteer.
              </p>
              <a class="card__link" href="#apply">Apply now</a>
            </article>
          </div>

          <p class="form-note" style="margin-top: 2rem; text-align: center">
            No current opening that matches your profile? Send us an open
            application — we keep every submission on file.
          </p>
        </div>
      </section>

      <!-- ==================== APPLY ==================== -->
      <section class="section" id="apply" aria-labelledby="apply-title">
        <div class="container">
          <div class="contact-grid">
            <div class="reveal">
              <p class="eyebrow">Apply Online</p>
              <h2 id="apply-title" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem)">
                Send us your application
              </h2>
              <p class="lead">
                Complete the form and our human resource team will review your
                details. Shortlisted applicants are contacted directly.
              </p>
              <ul class="check-list" style="margin-top: 1.5rem">
                <li><span>Applications are reviewed on a rolling basis.</span></li>
                <li>
                  <span
                    >Share a link to your CV (Google Drive, Dropbox or
                    OneDrive) so we can review it.</span
                  >
                </li>
                <li>
                  <span
                    >You can also email documents to
                    <a href="mailto:alphahillmedical@gmail.com"
                      >alphahillmedical@gmail.com</a
                    >.</span
                  >
                </li>
              </ul>
              <p class="form-note" style="margin-top: 1.5rem">
                Alpha Hill Medical Centre is an equal opportunity employer. We
                never charge a fee at any stage of recruitment.
              </p>
            </div>

            <div class="reveal">
              <p class="eyebrow">Application Form</p>
              <h2 style="font-size: clamp(1.6rem, 3.5vw, 2.2rem)">
                Your Details
              </h2>
              <form id="career-form" class="form" novalidate>
                <div class="row">
                  <div class="field">
                    <label for="c-name"
                      >Full Name <span class="req" aria-hidden="true">*</span></label
                    >
                    <input
                      type="text"
                      id="c-name"
                      name="full_name"
                      autocomplete="name"
                      required
                    />
                  </div>
                  <div class="field">
                    <label for="c-phone"
                      >Phone Number
                      <span class="req" aria-hidden="true">*</span></label
                    >
                    <input
                      type="tel"
                      id="c-phone"
                      name="phone"
                      autocomplete="tel"
                      required
                    />
                  </div>
                </div>

                <div class="field">
                  <label for="c-email"
                    >Email <span class="req" aria-hidden="true">*</span></label
                  >
                  <input
                    type="email"
                    id="c-email"
                    name="email"
                    autocomplete="email"
                    required
                  />
                </div>

                <div class="row">
                  <div class="field">
                    <label for="c-type"
                      >Opportunity Type
                      <span class="req" aria-hidden="true">*</span></label
                    >
                    <select id="c-type" name="opportunity_type" required>
                      <option value="">Select…</option>
                      <option>Vacancy</option>
                      <option>Internship</option>
                      <option>Attachment</option>
                      <option>Volunteer</option>
                      <option>Open Application</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="c-position"
                      >Position / Field
                      <span class="req" aria-hidden="true">*</span></label
                    >
                    <input
                      type="text"
                      id="c-position"
                      name="position"
                      placeholder="e.g. Registered Nurse"
                      required
                    />
                  </div>
                </div>

                <div class="field">
                  <label for="c-resume"
                    >Link to your CV
                    <span style="font-weight: 400; color: var(--muted)"
                      >(optional)</span
                    ></label
                  >
                  <input
                    type="url"
                    id="c-resume"
                    name="resume_url"
                    placeholder="https://…"
                  />
                </div>

                <div class="field">
                  <label for="c-letter"
                    >Cover Letter
                    <span style="font-weight: 400; color: var(--muted)"
                      >(optional)</span
                    ></label
                  >
                  <textarea
                    id="c-letter"
                    name="cover_letter"
                    placeholder="Tell us briefly about your experience and why you would like to join Alpha Hill."
                  ></textarea>
                </div>

                <button class="btn btn--primary" type="submit">
                  Submit Application
                </button>
                <p
                  id="career-status"
                  class="form-status"
                  role="status"
                  aria-live="polite"
                ></p>
                <p class="form-note">
                  By applying you consent to us storing your details for
                  recruitment purposes.
                </p>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/public-footer') %>

    <script src="/assets/js/main.js"></script>
  </body>
</html>
