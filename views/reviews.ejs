<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Reviews &amp; Feedback | Alpha Hill Medical Centre — Nandi County
    </title>
    <meta
      name="description"
      content="Share your experience at Alpha Hill Medical Centre. Your feedback is important and helps us improve the quality of healthcare we provide to the Nandi County community. Leave a review online."
    />
    <link rel="canonical" href="https://alphahillmedical.co.ke/reviews" />
    <meta name="theme-color" content="#001F5D" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alpha Hill Medical Centre" />
    <meta
      property="og:title"
      content="Reviews & Feedback | Alpha Hill Medical Centre"
    />
    <meta
      property="og:description"
      content="Your feedback matters. Share your experience and help us keep improving our care."
    />
    <meta
      property="og:image"
      content="https://alphahillmedical.co.ke/images/reception area hospital.jpeg"
    />
    <meta
      property="og:url"
      content="https://alphahillmedical.co.ke/reviews"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/png" href="/alphahillmedicallogo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/styles.css" />

    <!-- Structured data for SEO / AI answer engines -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["Hospital", "MedicalClinic"],
            "@id": "https://alphahillmedical.co.ke/#organization",
            "name": "Alpha Hill Medical Centre",
            "url": "https://alphahillmedical.co.ke/",
            "logo": "https://alphahillmedical.co.ke/alphahillmedicallogo.png",
            "telephone": "+254722865459",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Along Mosoriot – Kabiyet Road",
              "addressLocality": "Mosoriot",
              "addressRegion": "Nandi County",
              "postalCode": "30100",
              "addressCountry": "KE"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 0.3211582,
              "longitude": 35.1600144
            },
            "openingHours": "Mo-Su 00:00-23:59"
          },
          {
            "@type": "WebPage",
            "@id": "https://alphahillmedical.co.ke/reviews#webpage",
            "url": "https://alphahillmedical.co.ke/reviews",
            "name": "Reviews & Feedback | Alpha Hill Medical Centre",
            "description": "Share your experience at Alpha Hill Medical Centre. Your feedback helps us improve the quality of healthcare we provide to the Nandi County community.",
            "about": { "@id": "https://alphahillmedical.co.ke/#organization" },
            "inLanguage": "en"
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://alphahillmedical.co.ke/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Reviews & Feedback",
                "item": "https://alphahillmedical.co.ke/reviews"
              }
            ]
          }
        ]
      }
    </script>
  </head>
  <body>
    <%- include('partials/public-header', { current: '' }) %>

    <main id="main">
      <section class="page-hero" aria-labelledby="page-title">
        <div class="page-hero__bg">
          <img
            src="/images/reception area hospital.jpeg"
            alt="The welcoming reception area of Alpha Hill Medical Centre"
          />
        </div>
        <div class="container">
          <p class="breadcrumb">
            <a href="/">Home</a><span>/</span>Reviews &amp; Feedback
          </p>
          <h1 id="page-title">Reviews &amp; Feedback</h1>
          <p>
            Your experience matters to us — and your feedback helps us keep
            improving our services.
          </p>
        </div>
      </section>

      <!-- ==================== LEAVE A REVIEW ==================== -->
      <section class="section" aria-labelledby="leave-title">
        <div class="container">
          <div class="contact-grid">
            <!-- Why feedback matters -->
            <div class="reveal">
              <p class="eyebrow">Why Your Voice Matters</p>
              <h2
                id="leave-title"
                style="font-size: clamp(1.6rem, 3.5vw, 2.2rem)"
              >
                Feedback that shapes better care
              </h2>
              <p class="lead">
                At Alpha Hill Medical Centre, we are committed to delivering
                high-quality, compassionate healthcare. Listening to the people
                we serve is one of the most important ways we improve.
              </p>
              <p>
                Whether you want to celebrate a member of our team, tell us what
                went well, or point out something we can do better, your honest
                feedback helps us raise our standard of service for you and the
                whole Nandi County community.
              </p>
              <ul class="check-list" style="margin-top: 1.5rem">
                <li>
                  <span>Your feedback goes directly to our care team.</span>
                </li>
                <li>
                  <span
                    >We use it to improve our services and patient
                    experience.</span
                  >
                </li>
                <li>
                  <span
                    >For urgent medical concerns, please call us instead.</span
                  >
                </li>
              </ul>
              <p class="form-note" style="margin-top: 1.5rem">
                For medical emergencies, please call
                <a href="tel:+254722865459">+254 722 865 459</a> directly — do
                not use this form for urgent care.
              </p>
            </div>

            <!-- Review form -->
            <div class="reveal">
              <p class="eyebrow">Share Your Experience</p>
              <h2 style="font-size: clamp(1.6rem, 3.5vw, 2.2rem)">
                Leave a Review
              </h2>
              <form id="review-form" class="form" novalidate>
                <fieldset
                  class="field"
                  style="border: 0; padding: 0; margin: 0"
                >
                  <legend
                    style="
                      font-weight: 600;
                      font-size: 0.9rem;
                      color: var(--navy);
                      padding: 0;
                      margin-bottom: 0.4rem;
                    "
                  >
                    Your Rating
                    <span class="req" aria-hidden="true">*</span>
                  </legend>
                  <div
                    class="rating-input"
                    role="radiogroup"
                    aria-label="Star rating out of 5"
                  >
                    <input
                      type="radio"
                      id="star5"
                      name="rating"
                      value="5"
                      required
                    />
                    <label for="star5">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z"
                        />
                      </svg>
                      <span class="visually-hidden">5 stars — Excellent</span>
                    </label>
                    <input type="radio" id="star4" name="rating" value="4" />
                    <label for="star4">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z"
                        />
                      </svg>
                      <span class="visually-hidden">4 stars — Very good</span>
                    </label>
                    <input type="radio" id="star3" name="rating" value="3" />
                    <label for="star3">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z"
                        />
                      </svg>
                      <span class="visually-hidden">3 stars — Good</span>
                    </label>
                    <input type="radio" id="star2" name="rating" value="2" />
                    <label for="star2">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z"
                        />
                      </svg>
                      <span class="visually-hidden">2 stars — Fair</span>
                    </label>
                    <input type="radio" id="star1" name="rating" value="1" />
                    <label for="star1">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z"
                        />
                      </svg>
                      <span class="visually-hidden">1 star — Poor</span>
                    </label>
                  </div>
                </fieldset>

                <div class="row">
                  <div class="field">
                    <label for="rev-name"
                      >Your Name
                      <span class="req" aria-hidden="true">*</span></label
                    >
                    <input
                      type="text"
                      id="rev-name"
                      name="name"
                      autocomplete="name"
                      required
                    />
                  </div>
                  <div class="field">
                    <label for="rev-service">Service / Department</label>
                    <select id="rev-service" name="service">
                      <option value="">Select a service…</option>
                      <option>Intensive Care (ICU)</option>
                      <option>Maternity Services</option>
                      <option>Major &amp; Minor Surgeries</option>
                      <option>CT Scan &amp; Imaging</option>
                      <option>Laboratory Services</option>
                      <option>Pharmacy</option>
                      <option>Dental Services</option>
                      <option>Eyecare / Optometry</option>
                      <option>Dialysis Services</option>
                      <option>Physiotherapy</option>
                      <option>Outpatient / Consultation</option>
                      <option>Reception &amp; General</option>
                      <option>Other</option>
                    </select>
                  </div>
                </div>

                <div class="field">
                  <label for="rev-email"
                    >Email
                    <span style="font-weight: 400; color: var(--muted)"
                      >(optional)</span
                    ></label
                  >
                  <input
                    type="email"
                    id="rev-email"
                    name="email"
                    autocomplete="email"
                  />
                </div>
                <div class="field">
                  <label for="rev-phone"
                    >Phone Number
                    <span style="font-weight: 400; color: var(--muted)"
                      >(optional)</span
                    ></label
                  >
                  <input
                    type="tel"
                    id="rev-phone"
                    name="phone"
                    autocomplete="tel"
                  />
                </div>

                <div class="field">
                  <label for="rev-message"
                    >Your Review
                    <span class="req" aria-hidden="true">*</span></label
                  >
                  <textarea
                    id="rev-message"
                    name="message"
                    placeholder="Tell us about your experience — what went well, and how we can serve you better."
                    required
                  ></textarea>
                </div>

                <label
                  style="
                    display: flex;
                    gap: 0.6rem;
                    align-items: flex-start;
                    font-size: 0.9rem;
                    color: var(--muted);
                  "
                >
                  <input
                    type="checkbox"
                    id="rev-consent"
                    name="consent"
                    style="width: auto; margin-top: 0.25rem"
                  />
                  <span
                    >I’m happy for Alpha Hill Medical Centre to share my review
                    (first name only) on its website.</span
                  >
                </label>

                <button class="btn btn--primary" type="submit">
                  Submit Review
                </button>
                <p
                  id="review-status"
                  class="form-status"
                  role="status"
                  aria-live="polite"
                ></p>
              </form>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== RECENT REVIEWS ==================== -->
      <!-- Rendered from reviews approved in the dashboard. -->
      <section class="section section--grey" aria-labelledby="recent-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">What Our Patients Say</p>
            <h2 id="recent-title">Recent reviews from our community</h2>
            <div class="rule"></div>
          </div>

          <% if (reviews.length === 0) { %>
            <div class="news-empty">
              <h3>Be the first to share your experience</h3>
              <p>
                We publish reviews here once our team has read them. Use the
                form above to tell us about your visit — your feedback helps
                other patients and helps us improve.
              </p>
            </div>
          <% } else { %>
            <% if (summary && summary.average) { %>
              <p class="review-summary">
                <span class="score"><%= summary.average %></span>
                <span class="stars" role="img" aria-label="Average rating <%= summary.average %> out of 5">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="<%= i <= Math.round(summary.average) ? '' : 'off' %>">
                      <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z" />
                    </svg>
                  <% } %>
                </span>
                <span>average from <%= summary.total %> published review<%= summary.total === 1 ? '' : 's' %></span>
              </p>
            <% } %>

            <div class="grid grid--3">
              <% reviews.forEach(function (review) { %>
                <article class="review-card reveal">
                  <% if (review.rating) { %>
                    <span class="stars" role="img" aria-label="Rated <%= review.rating %> out of 5">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="<%= i <= review.rating ? '' : 'off' %>">
                          <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.86-5-4.87 7.1-1.01L12 2z" />
                        </svg>
                      <% } %>
                    </span>
                  <% } %>
                  <blockquote>&ldquo;<%= review.message %>&rdquo;</blockquote>
                  <div class="review-author">
                    <span class="review-avatar" aria-hidden="true"><%= initials(review.name) %></span>
                    <div>
                      <div class="name"><%= publicName(review.name) %></div>
                      <% if (review.service || review.location) { %>
                        <div class="meta">
                          <%= [review.service, review.location].filter(Boolean).join(' · ') %>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </div>
      </section>
    </main>

    <%- include('partials/public-footer') %>

    <script src="/assets/js/main.js"></script>
  </body>
</html>
