<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Insurance We Accept | Alpha Hill Medical Centre</title>
    <meta
      name="description"
      content="Alpha Hill Medical Centre accepts SHA (Social Health Authority), AAR Insurance, MUA, M-TIBA and First Assurance so you can access quality care with ease and peace of mind."
    />
    <link
      rel="canonical"
      href="https://alphahillmedical.co.ke/insurance"
    />
    <meta name="theme-color" content="#001F5D" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alpha Hill Medical Centre" />
    <meta
      property="og:title"
      content="Insurance We Accept | Alpha Hill Medical Centre"
    />
    <meta
      property="og:description"
      content="SHA, AAR, MUA, M-TIBA and First Assurance accepted."
    />
    <meta
      property="og:image"
      content="https://alphahillmedical.co.ke/images/reception area hospital.jpeg"
    />
    <meta
      property="og:url"
      content="https://alphahillmedical.co.ke/insurance"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/png" href="alphahillmedicallogo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="assets/css/styles.css" />

    <!-- Structured data for SEO / AI answer engines -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["Hospital", "MedicalClinic"],
            "@id": "https://alphahillmedical.co.ke/#organization",
            "name": "Alpha Hill Medical Centre",
            "url": "https://alphahillmedical.co.ke/",
            "logo": "https://alphahillmedical.co.ke/alphahillmedicallogo.png",
            "telephone": "+254722865459",
            "email": "alphahillmedical@gmail.com",
            "priceRange": "$$",
            "currenciesAccepted": "KES",
            "paymentAccepted": "Cash, SHA, AAR, MUA, M-TIBA, First Assurance",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Along Mosoriot – Kabiyet Road",
              "addressLocality": "Mosoriot",
              "addressRegion": "Nandi County",
              "postalCode": "30100",
              "addressCountry": "KE"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 0.3211582,
              "longitude": 35.1600144
            },
            "openingHours": "Mo-Su 00:00-23:59"
          },
          {
            "@type": "WebPage",
            "@id": "https://alphahillmedical.co.ke/insurance#webpage",
            "url": "https://alphahillmedical.co.ke/insurance",
            "name": "Insurance We Accept | Alpha Hill Medical Centre",
            "description": "Alpha Hill Medical Centre accepts SHA (Social Health Authority), AAR Insurance, MUA, M-TIBA and First Assurance so you can access quality care with ease and peace of mind.",
            "about": { "@id": "https://alphahillmedical.co.ke/#organization" },
            "inLanguage": "en"
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://alphahillmedical.co.ke/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Insurance",
                "item": "https://alphahillmedical.co.ke/insurance"
              }
            ]
          }
        ]
      }
    </script>
  </head>
  <body>
    <%- include('partials/public-header', { current: 'insurance' }) %>

    <main id="main">
      <section class="page-hero" aria-labelledby="page-title">
        <div class="page-hero__bg">
          <img
            src="images/reception area hospital.jpeg"
            alt="Reception area at Alpha Hill Medical Centre"
          />
        </div>
        <div class="container">
          <p class="breadcrumb"><a href="/">Home</a><span>/</span>Insurance</p>
          <h1 id="page-title">Insurance We Accept</h1>
          <p>
            Quality healthcare should never be out of reach. We work with
            leading insurance providers so you can access care with ease and
            peace of mind.
          </p>
        </div>
      </section>

      <section class="section" aria-labelledby="partners-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Cashless &amp; Covered</p>
            <h2 id="partners-title">Our Insurance Partners</h2>
            <div class="rule"></div>
          </div>
          <div class="grid grid--3">
            <article class="card reveal">
              <span class="icon" aria-hidden="true"
                ><svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4Z"
                  /></svg
              ></span>
              <h3>SHA — Social Health Authority</h3>
              <p>Including Bima Bora and Afya Nyumbani schemes.</p>
            </article>
            <article class="card reveal">
              <span class="icon" aria-hidden="true"
                ><svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4Z"
                  /></svg
              ></span>
              <h3>AAR Insurance</h3>
              <p>Comprehensive medical cover accepted across our services.</p>
            </article>
            <article class="card reveal">
              <span class="icon" aria-hidden="true"
                ><svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4Z"
                  /></svg
              ></span>
              <h3>MUA Insurance</h3>
              <p>Flexible cover for inpatient and outpatient care.</p>
            </article>
            <article class="card reveal">
              <span class="icon" aria-hidden="true"
                ><svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4Z"
                  /></svg
              ></span>
              <h3>M-TIBA</h3>
              <p>Mobile-based health wallet accepted for eligible services.</p>
            </article>
            <article class="card reveal">
              <span class="icon" aria-hidden="true"
                ><svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4Z"
                  /></svg
              ></span>
              <h3>First Assurance</h3>
              <p>Trusted cover for a broad range of medical needs.</p>
            </article>
            <article
              class="card reveal"
              style="background: var(--navy); color: #fff"
            >
              <h3 style="color: #fff">Don't see your provider?</h3>
              <p style="color: var(--on-navy-dim)">
                We are continually expanding our partnerships. Call us to
                confirm your cover.
              </p>
              <a class="card__link" href="tel:+254722865459" style="color: #fff"
                >Call +254 722 865 459 →</a
              >
            </article>
          </div>
        </div>
      </section>

      <section class="section section--grey" aria-labelledby="pay-title">
        <div class="container split">
          <div class="split__media reveal">
            <img
              src="images/womensupport.jpeg"
              alt="A patient being supported at Alpha Hill Medical Centre"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="reveal">
            <p class="eyebrow">Paying Without Insurance</p>
            <h2 id="pay-title">Affordable cash rates for everyone</h2>
            <p>
              In line with our mission of accessible care, we offer affordable
              cash rates for all services. Whether you are insured or paying out
              of pocket, you will receive the same high-quality, compassionate
              care.
            </p>
            <ul class="check-list">
              <li>
                <span>Transparent, reasonable pricing on every procedure</span>
              </li>
              <li>
                <span
                  >Friendly billing team to guide you through your options</span
                >
              </li>
              <li><span>Same standard of care for all patients</span></li>
            </ul>
            <a class="btn btn--outline" href="/contact"
              >Talk to Us About Your Cover</a
            >
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/public-footer') %>

    <script src="/assets/js/main.js"></script>
  </body>
</html>
